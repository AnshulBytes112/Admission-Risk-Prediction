# ==============================================================================
# EMERGENCY ADMISSION RISK PREDICTION - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting Docker Compose or local scripts:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project and Logging
# ------------------------------------------------------------------------------
PROJECT_NAME=emergency-admission-bda
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Host Port Mappings (Configurable to prevent local port conflicts)
# ------------------------------------------------------------------------------
# Kafka Ports
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093

# Hadoop HDFS Ports
NAMENODE_UI_PORT=9870
NAMENODE_RPC_PORT=9000
DATANODE_UI_PORT=9864

# Apache Spark Ports
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077

# Application Ports
API_PORT=8000
DASHBOARD_PORT=8501

# ------------------------------------------------------------------------------
# 3. Synthetic Data Generator Settings (Phase 1)
# ------------------------------------------------------------------------------
SYNTHETIC_ROWS=10000
SYNTHETIC_SEED=42
SYNTHETIC_OUTPUT_PATH=data/raw/patient_observations.csv
DATA_DIR=./data

# ------------------------------------------------------------------------------
# 4. Kafka Streaming Configuration (Phase 2)
# ------------------------------------------------------------------------------
# For host tools use localhost:9092; containers use kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=patient-observations
KAFKA_PARTITIONS=3
KAFKA_CONSUMER_GROUP=emergency-admission-bda-consumer
KAFKA_PUBLISH_DELAY_MS=25

# ------------------------------------------------------------------------------
# 5. Distributed Storage - Hadoop HDFS (Phase 3 & 4)
# ------------------------------------------------------------------------------
HDFS_URI=hdfs://namenode:9000
HDFS_BASE_PATH=/emergency-admission-bda
HDFS_RAW_PATH=/emergency-admission-bda/raw/kafka-events
HDFS_PROCESSED_PATH=/emergency-admission-bda/processed/patient-features
HDFS_QUARANTINE_PATH=/emergency-admission-bda/processed/quarantine

# ------------------------------------------------------------------------------
# 6. Machine Learning, API, and Dashboard (Phase 5 - 7)
# ------------------------------------------------------------------------------
MODEL_PATH=models/risk_model.joblib
RISK_THRESHOLD=0.7
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
DASHBOARD_API_URL=http://localhost:8000
